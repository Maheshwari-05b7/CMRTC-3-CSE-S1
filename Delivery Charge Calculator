public class Delivery {
    static int baseCharge = 50;
    String customerName;
    int distanceInKm;
    int calculateDeliveryCharge() {
        int ratePerKm = 10;
        int totalCharge = baseCharge + (distanceInKm * ratePerKm);
        return totalCharge;
    }
    void displayDetails() {
        System.out.println("Customer: " +this.customerName);
        System.out.println("Distance: " +this.distanceInKm);
        System.out.println("Total Delivery Charge: ₹" +this.calculateDeliveryCharge());
        System.out.println();
    }
    
    public static void main(String[] args){
        Delivery customer1 = new Delivery();
        customer1.customerName = "Mahii";
        customer1.distanceInKm = 5;
        Delivery customer2 = new Delivery();
        customer2.customerName = "Sherewar";
        customer2.distanceInKm = 10;
        customer1.displayDetails();
        customer2.displayDetails();
    }
}
