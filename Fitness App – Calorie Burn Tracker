public class WorkoutTracker {
    private String userName;
    private int age;
    private double weight; 
    private String workoutType;
    private int duration; 
    private static final double RUNNING_MET = 9.8;
    private static final double CYCLING_MET = 7.5;
    private static final double SWIMMING_MET = 8.3;
    public WorkoutTracker(String userName, int age, double weight, String workoutType, int duration) {
        this.userName = userName;
        this.age = age;
        this.weight = weight;
        this.workoutType = workoutType;
        this.duration = duration;
    }
    private double getMetValue() {
        switch (workoutType.toLowerCase()) {
            case "running":
                return RUNNING_MET;
            case "cycling":
                return CYCLING_MET;
            case "swimming":
                return SWIMMING_MET;
            default:
                throw new IllegalArgumentException("Invalid workout type: " + workoutType);
        }
    }
    private double calculateCaloriesBurned() {
        double met = getMetValue();
        double caloriesPerMinute = 0.0175 * met * weight;
        return caloriesPerMinute * duration;
    }
    public void displaySummary() {
        double caloriesBurned = calculateCaloriesBurned();
        System.out.println("User: " + userName);
        System.out.println("Workout: " + workoutType);
        System.out.println("Weight: " + weight + " kg");
        System.out.println("Duration: " + duration + " minutes");
        System.out.printf("Calories Burned: %.1f\n", caloriesBurned);
        System.out.println();
    }
    public static void main(String[] args) {
        WorkoutTracker user1 = new WorkoutTracker("Neha", 28, 60.0, "Running", 30);
        WorkoutTracker user2 = new WorkoutTracker("Raj", 35, 70.5, "Cycling", 45);
        WorkoutTracker user3 = new WorkoutTracker("Anita", 25, 55.0, "Swimming", 60);

        user1.displaySummary();
        user2.displaySummary();
        user3.displaySummary();
    }
}
